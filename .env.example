# Set these in the backend environment only. Never put provider credentials in the frontend.
FIELD_NOTE_AI_API_KEY=
FIELD_NOTE_AI_BASE_URL=https://openrouter.ai/api/v1
FIELD_NOTE_AI_PROVIDER_NAME=openrouter
# Select an image-capable open-weight model supported by your provider.
FIELD_NOTE_AI_MODEL=qwen/qwen2.5-vl-72b-instruct
# Optional: an audio transcription model supported by the configured provider.
FIELD_NOTE_AI_TRANSCRIPTION_MODEL=
FIELD_NOTE_AI_TIMEOUT_SECONDS=45
